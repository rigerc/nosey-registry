{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nosey/schemas/repositories.schema.json",
  "title": "Nosey repository metadata document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositories"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repositories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repository"
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "git",
            "local"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "description": "Source Git repository URI or Skills CLI Git shorthand, for kind=git.",
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_./-]*|https://[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]+)?/[A-Za-z0-9._~%/?=&+\\-]+|ssh://(?:[A-Za-z0-9._-]+@)?[A-Za-z0-9][A-Za-z0-9.-]*/[A-Za-z0-9._/-]+|git@[A-Za-z0-9][A-Za-z0-9.-]*:[A-Za-z0-9._/-]+)$",
          "maxLength": 2048
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative directory within this Nosey registry, for kind=local.",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_./-]+$",
          "maxLength": 512
        },
        "disabled": {
          "type": "boolean"
        }
      }
    }
  }
}
