{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nosey/schemas/settings.schema.json",
  "title": "Nosey settings v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "registries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/registrySetting"
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttlHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "method": {
          "enum": [
            "symlink",
            "copy"
          ]
        },
        "defaultMode": {
          "enum": [
            "execute",
            "print"
          ]
        },
        "verbose": {
          "type": "boolean"
        },
        "cliVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Pinned skills CLI version override only if within Nosey-supported range."
        },
        "upstreamTelemetry": {
          "enum": [
            "inherit",
            "disabled"
          ],
          "description": "Default inherit; disabled passes DISABLE_TELEMETRY=1 to upstream."
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "adapters": {
          "type": "array",
          "description": "User config only: trusted adapters; project config cannot enable. Semantic validator enforces scope and hash integrity.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "version",
              "sha256",
              "path",
              "enabled"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9._-]*$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Absolute user-level installed adapter location (semantic validator verifies containment)."
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        },
        "enableMcpPackage": {
          "type": "boolean",
          "default": false,
          "description": "Opt in to passive inspection of supported workspace MCP server configuration files for mcp_package rules. No MCP process is started."
        }
      }
    }
  },
  "$defs": {
    "registrySetting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "url"
              ],
              "properties": {
                "kind": {
                  "const": "git"
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_./-]*|https://[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]+)?/[A-Za-z0-9._~%/?=&+\\-]+|ssh://(?:[A-Za-z0-9._-]+@)?[A-Za-z0-9][A-Za-z0-9.-]*/[A-Za-z0-9._/-]+|git@[A-Za-z0-9][A-Za-z0-9.-]*:[A-Za-z0-9._/-]+)$",
                  "maxLength": 2048
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
                  "maxLength": 200
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "const": "local"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?:~/?|/|[A-Za-z0-9_.-])[A-Za-z0-9_./-]*$",
                  "description": "Project config: workspace-root-relative or absolute; user config: absolute or ~/ path (enforced by semantic validator)."
                }
              }
            }
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "ttlHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168,
          "description": "Overrides updates.ttlHours for this registry only."
        }
      }
    }
  }
}
