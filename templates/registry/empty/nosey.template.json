{
  "schemaVersion": 1,
  "id": "empty",
  "kind": "registry",
  "generator": "registry-v1",
  "description": "Empty registry scaffold with optional GitHub CI",
  "files": [
    {
      "source": "files/nosey.registry.config.json",
      "destination": "nosey.registry.config.json"
    },
    {
      "source": "files/technologies.json",
      "destination": "technologies.json"
    },
    {
      "source": "files/skills.json",
      "destination": "skills.json"
    },
    {
      "source": "files/mappings.json",
      "destination": "mappings.json"
    },
    {
      "source": "files/repositories.json",
      "destination": "repositories.json"
    },
    {
      "source": "files/README.md",
      "destination": "README.md"
    }
  ],
  "ci": [
    {
      "provider": "github",
      "source": "files/ci/github/registry.yml",
      "destination": ".github/workflows/registry.yml"
    }
  ]
}
